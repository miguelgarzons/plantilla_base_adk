# ══════════════════════════════════════════════════════════════
# Plantilla Base ADK - Variables de Entorno
# ══════════════════════════════════════════════════════════════
# Copia este archivo como .env y reemplaza los valores.
#   cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ── Modelo LLM ───────────────────────────────────────────────
AGENT_MODEL=gemini-2.5-pro
GEMINI_API_KEY=tu_gemini_api_key_aqui

# ── Zoho MCP (obligatorio para herramientas Zoho Desk) ──────
ZOHO_MCP_URL=https://tu-instancia.zohomcp.com/mcp/<token>/message
ZOHO_ORG_ID=tu_org_id_aqui

# ── Zoho Attachments (REST API directa) ─────────────────────
# Solo necesario si usas zoho_attachments.py
ZOHO_DESK_BASE_URL=https://desk.zoho.com/api/v1
ZOHO_TOKEN_WEBHOOK_URL=https://tu-webhook.ejemplo.com/webhook/GetToken
ZOHO_TOKEN_WEBHOOK_USER=tu_usuario_webhook
ZOHO_TOKEN_WEBHOOK_PASS=tu_password_webhook

# ── API Externa de ejemplo (student_profile.py) ─────────────
# Solo necesario si usas el ejemplo de API REST externa
EXTERNAL_API_BASE_URL=https://tu-api.ejemplo.com/api/v1
EXTERNAL_API_USERNAME=tu_usuario_api
EXTERNAL_API_PASSWORD=tu_password_api
